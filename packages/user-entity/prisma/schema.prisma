// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator prismaClassGenerator {
  provider = "prisma-class-validator-generator"
  output   = "./generated/classes"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  uid       String     @id @default(uuid())  @db.Uuid 
  userName  String?
  emailId   String?
  firstName String
  lastName  String
  mobileNumber Int?
  clerkId  String   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime @updatedAt
  isLoggedInOnce Boolean @default(false)
  apps          UserApp[]   // 👈 Many-to-Many relation through UserApp table
  groups       UserGroup[] // 👈 Many-to-Many relation through UserApp table
  UserRole UserRole[]
}


model App{
  id Int @id @default(autoincrement())
  name String
  description String
  roles   AppRoles[] 
  users   UserApp[]
  UserRole UserRole[]
}

model AppRoles{
  id Int @id @default(autoincrement())
  name String
  description String
  appId       Int    // 👈 Foreign key field
  app         App    @relation(fields: [appId], references: [id])
  actions  RoleActions[]
  UserRole UserRole[]
}

model RoleActions{
  id Int @id @default(autoincrement())
  name String
  description String
  roleId Int    // 👈 Foreign key field
  roles  AppRoles @relation(fields: [roleId], references: [id])
}


// 👇 Junction Table for Many-to-Many Relationship
model UserApp {
  userId  String @db.Uuid  // Foreign Key for User
  appId   Int              // Foreign Key for App
  user    User  @relation(fields: [userId], references: [uid], onDelete: Cascade)
  app     App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@id([userId, appId]) // 👈 Composite Primary Key to ensure uniqueness
}

model UserRole {
  userId  String @db.Uuid  // Foreign Key for User
  roleId   Int              // Foreign Key for App
  appId  Int 
  user    User  @relation(fields: [userId], references: [uid], onDelete: Cascade)
  role    AppRoles  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  app  App @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@id([userId, roleId, appId]) // 👈 Composite Primary Key to ensure uniqueness
}


model Group {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  users       UserGroup[]  // 👈 Many-to-Many relation through UserGroup table
}

model UserGroup {
  userId  String  @db.Uuid  // Foreign Key for User
  groupId Int               // Foreign Key for Group
  user    User   @relation(fields: [userId], references: [uid], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([userId, groupId]) // 👈 Composite Primary Key to ensure uniqueness
}
