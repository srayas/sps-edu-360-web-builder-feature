{
  "name": "@spsedu360/web-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 3002",
    "start": "ng serve --host 0.0.0.0 --port 3002",
    "build": "ng build",
    "lint": "ngc -p tsconfig.app.json --noEmit",
    "tsc": "tsc --noEmit -p tsconfig.app.json",
    "test": "esbuild src/app/core/model/*.spec.ts src/app/core/runtime/*.spec.ts --bundle --platform=node --format=esm --outdir=.test --out-extension:.js=.mjs --log-level=warning && node --test '.test/**/*.spec.mjs'",
    "ai:docs": "esbuild scripts/ai-docs.ts --bundle --platform=node --format=esm --outfile=.test/ai-docs.mjs --log-level=warning && node .test/ai-docs.mjs",
    "spec:check": "esbuild scripts/check-spec.ts --bundle --platform=node --format=esm --outfile=.test/check-spec.mjs --log-level=warning && node .test/check-spec.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/cdk": "22.2.2",
    "@angular/material": "22.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "@spsedu360/shared-ui": "workspace:*",
    "@spsedu360/json-logic": "workspace:*"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@types/node": "^24",
    "typescript": "~6.0.0",
    "esbuild": "^0.28.0"
  }
}
