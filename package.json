{
  "name": "spsedu360",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "pnpm exec nx run-many -t test",
    "build": "pnpm exec nx run-many -t build",
    "format": "prettier  \"{apps,api,libs,packages}/**/*.{ts,tsx,js,json,mjs}\" --ignore-path .gitignore",
    "format:check": "pnpm format --check",
    "format:write": "pnpm format --write",
    "lint": "pnpm exec nx run-many -t lint",
    "tsc": "pnpm exec nx run-many -t tsc",
    "validate": "pnpm format:write && pnpm tsc && pnpm lint",
    "prepare": "husky",
    "dev:builder": "pnpm --filter @spsedu360/web-builder dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nx": "^20.4.4",
    "prettier": "^3.5.1",
    "userland": "^0.4.3"
  }
}
